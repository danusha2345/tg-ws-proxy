<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TgWsProxy" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/signal</item>
        <item name="android:buttonStyle">@style/Widget.TgWsProxy.Button</item>
    </style>

    <style name="Widget.TgWsProxy.Button" parent="android:style/Widget.Material.Button">
        <item name="android:backgroundTint">@null</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
    </style>
</resources>
